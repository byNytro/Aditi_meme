#!/bin/sh
# Strip Cursor agent attribution from commit messages.
COMMIT_MSG_FILE=$1
[ -f "$COMMIT_MSG_FILE" ] || exit 0

TMP="${COMMIT_MSG_FILE}.tmp"
grep -v 'cursoragent@cursor\.com' "$COMMIT_MSG_FILE" |
  grep -v 'Made-with: Cursor' |
  grep -v 'Co-authored-by: Cursor' >"$TMP" && mv "$TMP" "$COMMIT_MSG_FILE"
